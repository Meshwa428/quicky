#!/usr/bin/env bash
# quicky — backend for the oma-quicky wheel.
#
#   quicky convert <ext>    FILE...   convert each file to <ext>
#   quicky tool    <name>   FILE...   compress, mute, normalize, extract, ...
#   quicky action  <name>   FILE...   send, copy, move, zip, trash, ...
#
# Tools with choices open an editor app (see apps/). Compress is both: the
# wheel opens quicky-compress, which calls back here with its settings:
#
#   quicky tool compress [--preset balanced|strong] [--scale PCT]
#                        [--target-mb MB | --target-pct PCT] FILE...
#
# Everything runs locally with the tools Omarchy already ships: ImageMagick,
# ffmpeg, LibreOffice, poppler, ghostscript, qpdf and 7z. Outputs land next to
# the source file and are never written over an existing file.

set -uo pipefail

APP="Quicky"

notify() { notify-send -a "$APP" "$1" "${2:-}"; }
die() { notify "Failed" "$1"; echo "quicky: $1" >&2; exit 1; }

lower() { tr '[:upper:]' '[:lower:]' <<<"$1"; }
ext_of() { local b=${1##*/}; [[ $b == *.* ]] && lower "${b##*.}"; }
stem_of() { local b=${1##*/}; echo "${b%.*}"; }
dir_of() { local d; d=$(dirname -- "$1"); echo "$d"; }

is_image() { [[ $1 =~ ^(jpg|jpeg|png|webp|heic|heif|tif|tiff|avif|bmp|gif|svg|ico)$ ]]; }
is_video() { [[ $1 =~ ^(mp4|mov|mkv|webm|avi|wmv|m4v|flv)$ ]]; }
is_audio() { [[ $1 =~ ^(mp3|m4a|wav|flac|ogg|opus|aiff|aif|wma|aac)$ ]]; }
is_doc() { [[ $1 =~ ^(docx|doc|odt|rtf|txt|html|htm|md|markdown|pptx|ppt|odp|xlsx|xls|ods|csv|tsv)$ ]]; }
is_sub() { [[ $1 =~ ^(srt|vtt)$ ]]; }
is_archive() { [[ $1 =~ ^(zip|7z|tar|gz|tgz|bz2|xz|rar)$ ]]; }

# Pick where an output file should go when <dir>/<stem>.<ext> may already
# exist. Print the chosen path on stdout.
unique_path() {
  local dir=$1 stem=$2 ext=$3
  local candidate="$dir/$stem.$ext"

  # TODO(you): decide the collision policy. Options worth weighing:
  #   - suffix:  photo.png → photo-1.png, photo-2.png ...  (never loses data)
  #   - subdir:  write everything into "$dir/quicky/"      (tidy, but hidden)
  #   - replace: overwrite silently                        (fast, destructive)
  # Until then we refuse rather than clobber.
  [[ -e $candidate ]] && die "$candidate already exists"
  echo "$candidate"
}

# ---------------------------------------------------------------- convert

convert_one() {
  local src=$1 to=$2 from dir stem out tmp
  from=$(ext_of "$src")
  dir=$(dir_of "$src")
  stem=$(stem_of "$src")

  # PDFs to images produce one file per page, so they bypass unique_path.
  if [[ $from == pdf && $to =~ ^(png|jpg)$ ]]; then
    local fmt=png; [[ $to == jpg ]] && fmt=jpeg
    pdftoppm -r 300 "-$fmt" "$src" "$dir/$stem" || return 1
    return 0
  fi

  # Documents and slides to images: render to PDF first, then one image per page.
  if is_doc "$from" && [[ $to =~ ^(png|jpg)$ ]]; then
    local fmt=png; [[ $to == jpg ]] && fmt=jpeg
    tmp=$(mktemp -d)
    soffice --headless --convert-to pdf --outdir "$tmp" "$src" >/dev/null &&
      pdftoppm -r 150 "-$fmt" "$tmp/$stem.pdf" "$dir/$stem"
    local rc=$?
    rm -rf -- "$tmp"
    return $rc
  fi

  # Archives to .tar.gz keep the double extension.
  if [[ $to == gz ]]; then
    out=$(unique_path "$dir" "${stem%.tar}" tar.gz) || return 1
    tmp=$(mktemp -d)
    7z x -y -o"$tmp" "$src" >/dev/null && tar -czf "$out" -C "$tmp" .
    local rc=$?
    rm -rf -- "$tmp"
    return $rc
  fi

  out=$(unique_path "$dir" "$stem" "$to") || return 1

  if is_sub "$from" && [[ $to == txt ]]; then
    # Keep only the spoken lines: drop cue numbers, timings, and the header.
    grep -v -E '^[0-9]+\s*$|-->|^WEBVTT|^NOTE' "$src" | tr -d '\r' | cat -s | sed '/./,$!d' >"$out"
  elif is_sub "$from"; then
    ffmpeg -hide_banner -loglevel error -i "$src" "$out"
  elif [[ $to == gif ]] && is_video "$from"; then
    ffmpeg -hide_banner -loglevel error -i "$src" \
      -vf "fps=12,scale='min(720,iw)':-1:flags=lanczos,split[a][b];[a]palettegen[p];[b][p]paletteuse" \
      "$out"
  elif is_video "$to" || is_audio "$to"; then
    ffmpeg -hide_banner -loglevel error -i "$src" "$out"
  elif is_image "$from" && { is_image "$to" || [[ $to == pdf ]]; }; then
    magick "$src" "$out"
  elif [[ $from == pdf && $to == txt ]]; then
    pdftotext -layout "$src" "$out"
  elif [[ $from == pdf && $to == md ]]; then
    # LibreOffice imports PDFs as positioned text boxes, which its Markdown
    # export drops; reflowed text is the useful Markdown here.
    pdftotext "$src" "$out"
  elif [[ $from == pdf ]]; then
    local infilter=writer_pdf_import; [[ $to == pptx ]] && infilter=impress_pdf_import
    tmp=$(mktemp -d)
    soffice --headless --infilter="$infilter" --convert-to "$to" --outdir "$tmp" "$src" >/dev/null &&
      mv -- "$tmp/$stem.$to" "$out"
    rm -rf -- "$tmp"
  elif [[ $to == tsv ]]; then
    # LibreOffice writes TSV as CSV with a tab separator (9) and, via the 7th
    # token, without quoting every text cell.
    tmp=$(mktemp -d)
    soffice --headless --convert-to 'csv:Text - txt - csv (StarCalc):9,34,76,1,,0,false,true,true' --outdir "$tmp" "$src" >/dev/null &&
      mv -- "$tmp/$stem.csv" "$out"
    rm -rf -- "$tmp"
  elif is_doc "$from"; then
    tmp=$(mktemp -d)
    soffice --headless --convert-to "$to" --outdir "$tmp" "$src" >/dev/null &&
      mv -- "$tmp/$stem.$to" "$out"
    rm -rf -- "$tmp"
  elif is_archive "$from"; then
    tmp=$(mktemp -d)
    7z x -y -o"$tmp" "$src" >/dev/null || { rm -rf -- "$tmp"; return 1; }
    if [[ $to == tar ]]; then
      tar -cf "$out" -C "$tmp" .
    else
      (cd "$tmp" && 7z a "$out" . >/dev/null)
    fi
    rm -rf -- "$tmp"
  else
    echo "no converter for .$from → .$to" >&2
    return 1
  fi
}

# ---------------------------------------------------------------- tools

tool_one() {
  local tool=$1 src=$2 from dir stem out
  from=$(ext_of "$src")
  dir=$(dir_of "$src")
  stem=$(stem_of "$src")

  case $tool in
    compress)
      out=$(unique_path "$dir" "$stem-small" "$from") || return 1
      compress_one "$src" "$out" "$from" || { rm -f -- "$out"; return 1; }
      ;;
    strip)
      out=$(unique_path "$dir" "$stem-clean" "$from") || return 1
      if is_image "$from"; then magick "$src" -strip "$out"
      elif is_video "$from" || is_audio "$from"; then ffmpeg -hide_banner -loglevel error -i "$src" -map_metadata -1 -c copy "$out"
      elif [[ $from == pdf ]]; then qpdf --empty --pages "$src" -- "$out"
      else return 1; fi
      ;;
    mute)
      out=$(unique_path "$dir" "$stem-muted" "$from") || return 1
      ffmpeg -hide_banner -loglevel error -i "$src" -an -c:v copy "$out"
      ;;
    split)
      pdfseparate "$src" "$dir/$stem-%d.pdf"
      ;;
    snapshot)
      # The middle frame is usually more representative than the first.
      out=$(unique_path "$dir" "$stem-snapshot" png) || return 1
      local dur; dur=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$src")
      ffmpeg -hide_banner -loglevel error -ss "$(awk -v d="${dur:-0}" 'BEGIN{print d/2}')" -i "$src" -frames:v 1 "$out"
      ;;
    normalize)
      # Tangerine's defaults: -16 LUFS, 11 LU range, -1.5 dBTP true-peak ceiling.
      out=$(unique_path "$dir" "$stem-normalized" "$from") || return 1
      ffmpeg -hide_banner -loglevel error -i "$src" -af "loudnorm=I=-16:LRA=11:TP=-1.5" -ar 48000 "$out"
      ;;
    channels)
      local n; n=$(ffprobe -v error -select_streams a:0 -show_entries stream=channels -of csv=p=0 "$src")
      if ((${n:-2} > 1)); then
        out=$(unique_path "$dir" "$stem-mono" "$from") || return 1
        ffmpeg -hide_banner -loglevel error -i "$src" -ac 1 "$out"
      else
        out=$(unique_path "$dir" "$stem-stereo" "$from") || return 1
        ffmpeg -hide_banner -loglevel error -i "$src" -ac 2 "$out"
      fi
      ;;
    visualize)
      # A waveform video in the active theme's accent color.
      out=$(unique_path "$dir" "$stem-visual" mp4) || return 1
      local theme="$HOME/.local/state/omarchy/current/theme/colors.toml" fg bg
      fg=$(sed -n 's/^accent *= *"\(#[0-9a-fA-F]\{6\}\)".*/\1/p' "$theme" 2>/dev/null | head -1)
      bg=$(sed -n 's/^background *= *"\(#[0-9a-fA-F]\{6\}\)".*/\1/p' "$theme" 2>/dev/null | head -1)
      ffmpeg -hide_banner -loglevel error -i "$src" -f lavfi -i "color=c=${bg:-#101315}:s=1280x720" \
        -filter_complex "[0:a]showwaves=s=1280x720:mode=cline:rate=30:colors=${fg:-#cacccc}[w];[1][w]overlay=format=auto:shortest=1,format=yuv420p[v]" \
        -map "[v]" -map 0:a -c:v libx264 -preset veryfast -c:a aac -b:a 192k -shortest "$out"
      ;;
    extract)
      local target="$dir/$stem"
      [[ -e $target ]] && target=$(mktemp -d "$dir/$stem-XXXX")
      7z x -y -o"$target" "$src" >/dev/null
      ;;
    *)
      echo "unknown tool: $tool" >&2
      return 1
      ;;
  esac
}

# Compress settings, from the quicky-compress window (defaults otherwise).
PRESET=balanced   # balanced | strong
SCALE=100         # image / video size, percent
TARGET_MB=""      # aim for this many MB per file ...
TARGET_PCT=""     # ... or this many percent smaller

compress_one() {
  local src=$1 out=$2 from=$3 strong=0 target=""
  [[ $PRESET == strong ]] && strong=1
  if [[ -n $TARGET_MB ]]; then
    target=$(awk -v m="$TARGET_MB" 'BEGIN{printf "%d", m*1048576}')
  elif [[ -n $TARGET_PCT ]]; then
    target=$(awk -v s="$(stat -c %s "$src")" -v p="$TARGET_PCT" 'BEGIN{printf "%d", s*(100-p)/100}')
  fi

  if is_image "$from"; then
    local q=$((strong ? 60 : 78)) args=(-strip)
    ((SCALE < 100)) && args+=(-resize "$SCALE%")
    case $from in
      jpg|jpeg) args+=(-quality "$q"); [[ -n $target ]] && args+=(-define "jpeg:extent=$target") ;;
      webp) args+=(-quality "$q"); [[ -n $target ]] && args+=(-define "webp:target-size=$target") ;;
      png) args+=(-define png:compression-level=9); ((strong)) && args+=(-colors 256) ;;
      *) args+=(-quality "$q") ;;
    esac
    magick "$src" "${args[@]}" "$out" || return 1
    # PNG has no quality knob: shrink the picture until it fits the target.
    if [[ $from == png && -n $target ]]; then
      local s=$SCALE
      while (($(stat -c %s "$out") > target && s > 10)); do
        s=$((s - 10))
        magick "$src" "${args[@]}" -resize "$s%" "$out" || return 1
      done
    fi
  elif is_video "$from"; then
    local vf=() rate=(-crf "$((strong ? 32 : 26))")
    ((SCALE < 100)) && vf=(-vf "scale=trunc(iw*$SCALE/200)*2:-2")
    if [[ -n $target ]]; then
      # Two passes at the bitrate that fills the target, less 128k of audio.
      local dur kbps log
      dur=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$src")
      kbps=$(awk -v t="$target" -v d="${dur:-1}" 'BEGIN{k=t*8/d/1000-128; printf "%d", (k<50?50:k)}')
      log=$(mktemp -u)
      ffmpeg -hide_banner -loglevel error -y -i "$src" "${vf[@]}" -c:v libx264 -b:v "${kbps}k" -preset medium \
        -pass 1 -passlogfile "$log" -an -f null /dev/null || return 1
      rate=(-b:v "${kbps}k" -pass 2 -passlogfile "$log")
    fi
    ffmpeg -hide_banner -loglevel error -i "$src" "${vf[@]}" -c:v libx264 "${rate[@]}" -preset medium \
      -c:a aac -b:a 128k "$out"
    local rc=$?
    [[ -n ${log:-} ]] && rm -f -- "$log"*
    return $rc
  elif is_audio "$from"; then
    local kbps=$((strong ? 64 : 128))
    if [[ -n $target ]]; then
      local dur; dur=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$src")
      kbps=$(awk -v t="$target" -v d="${dur:-1}" 'BEGIN{k=t*8/d/1000; printf "%d", (k<16?16:k)}')
    fi
    ffmpeg -hide_banner -loglevel error -i "$src" -b:a "${kbps}k" "$out"
  elif [[ $from == pdf ]]; then
    local level=/ebook; ((strong)) && level=/screen
    gs -q -sDEVICE=pdfwrite -dPDFSETTINGS=$level -dNOPAUSE -dBATCH -o "$out" "$src" || return 1
    if [[ -n $target && $level == /ebook ]] && (($(stat -c %s "$out") > target)); then
      gs -q -sDEVICE=pdfwrite -dPDFSETTINGS=/screen -dNOPAUSE -dBATCH -o "$out" "$src"
    fi
  else
    return 1
  fi
}

# ---------------------------------------------------------------- actions

action() {
  local name=$1; shift
  case $name in
    copy-path)
      printf '%s\n' "$@" | wl-copy --trim-newline
      notify "Copied path" "$(($#)) item(s)"
      ;;
    copy-file)
      for f in "$@"; do printf 'file://%s\n' "$(realpath -- "$f")"; done | wl-copy -t text/uri-list
      notify "Copied" "$(($#)) item(s) — paste in Files"
      ;;
    terminal)
      local d=$1; [[ -d $d ]] || d=$(dir_of "$1")
      setsid uwsm-app -- xdg-terminal-exec --dir="$d" >/dev/null 2>&1 &
      ;;
    move)
      local dest
      dest=$(zenity --file-selection --directory --title="Move $# item(s) to…" --filename="$(dir_of "$1")/" 2>/dev/null) || return 0
      mv -n -- "$@" "$dest"/ && notify "Moved" "$# item(s) to $dest"
      ;;
    zip)
      local name out; name=$(stem_of "$1"); (($# > 1)) && name=archive
      out=$(unique_path "$(dir_of "$1")" "$name" zip) || return 1
      7z a -tzip "$out" "$@" >/dev/null && notify "Zipped" "${out##*/}"
      ;;
    send)
      systemd-run --user --quiet --collect localsend --headless send "$@"
      ;;
    float)
      # mpv shows images and media under the `quicky-float` app id, which the
      # rules from `quicky setup` float and pin. Anything else opens normally.
      local ext; ext=$(ext_of "$1")
      if is_image "$ext" || is_video "$ext" || is_audio "$ext"; then
        setsid -f mpv --force-window --keep-open=yes --image-display-duration=inf \
          --wayland-app-id=quicky-float --title="Float — ${1##*/}" "$1" >/dev/null 2>&1
      else
        setsid -f xdg-open "$1" >/dev/null 2>&1
      fi
      ;;
    trash)
      gio trash -- "$@" && notify "Moved to trash" "$(($#)) item(s)"
      ;;
    *)
      die "unknown action: $name"
      ;;
  esac
}

# ---------------------------------------------------------------- open

PLUGIN_ID="meshwa.oma-quicky"
NAUTILUS_KEY="F4"
NAUTILUS_SCRIPT="$HOME/.local/share/nautilus/scripts/Quicky"

# Open the wheel. With files, open it on them. Without, and with Files
# focused, ask Nautilus to hand over its selection through the script
# shortcut — Wayland apps can't read another app's selection directly.
open_wheel() {
  # From the Nautilus script: open on these files, or (nothing selected) on
  # the clipboard / as a drop target. Never ask Nautilus again from here,
  # or an empty selection would loop.
  if [[ ${1:-} == --wheel ]]; then
    omarchy-shell shell summon "$PLUGIN_ID" '{}' >/dev/null
    return
  fi
  if (($# > 0)); then
    omarchy-shell shell summon "$PLUGIN_ID" "$(jq -cn '{files: $ARGS.positional}' --args "$@")" >/dev/null
    return
  fi

  local class
  class=$(hyprctl -j activewindow 2>/dev/null | jq -r '.class // ""')
  if [[ $class == org.gnome.Nautilus && -x $NAUTILUS_SCRIPT ]]; then
    # Hyprland's Lua config takes dispatchers as Lua. Explicit empty mods keep
    # the still-held Super+Alt out of the key; down/up mirrors Omarchy's own
    # send_shortcut_once helper.
    local key="{ mods = \"\", key = \"$NAUTILUS_KEY\", state ="
    hyprctl dispatch "hl.dsp.send_key_state($key \"down\" })" >/dev/null
    hyprctl dispatch "hl.dsp.send_key_state($key \"up\" })" >/dev/null

    # Nautilus ignores keys while a drag is in progress, so don't wait for
    # it: open the drop wheel now, under the cursor. If Nautilus does answer,
    # its summon refills the open wheel with the selection.
    omarchy-shell shell summon "$PLUGIN_ID" '{"drop":true}' >/dev/null
  else
    omarchy-shell shell toggle "$PLUGIN_ID" '{}' >/dev/null
  fi
}

# Window rules for the editor apps and the Float viewer, loaded the way
# Omarchy loads optional Hyprland modules, so a missing file is harmless.
setup_hyprland() {
  local rules="$HOME/.config/hypr/quicky.lua" conf="$HOME/.config/hypr/hyprland.lua"
  cat >"$rules" <<'LUA'
-- Installed by oma-quicky (`quicky setup`).
-- Editors (quicky-trim, quicky-crop, ...) open floating and centered, at
-- the compact size each app asks for. Hyprland matches the whole class,
-- hence the trailing .*
o.window({ class = "quicky\\..*" }, { float = true, center = true })
-- The Float action: a small pinned viewer in the top-right corner.
o.window({ class = "quicky-float" }, {
  float = true,
  pin = true,
  size = { 640, 400 },
  move = { "(monitor_w-window_w-40)", "(monitor_h*0.06)" },
})
LUA
  if [[ -f $conf ]] && ! grep -q 'module("hypr.quicky")' "$conf"; then
    echo 'require("default.hypr.require_optional").module("hypr.quicky") -- oma-quicky window rules' >>"$conf"
  fi
  echo "Hyprland: window rules in $rules"
}

# Nautilus runs scripts from ~/.local/share/nautilus/scripts and can bind
# them to keys via ~/.config/nautilus/scripts-accels.
setup_nautilus() {
  local self accels="$HOME/.config/nautilus/scripts-accels"
  self=$(realpath -- "$0")
  mkdir -p "$(dirname "$NAUTILUS_SCRIPT")" "$(dirname "$accels")"
  cat >"$NAUTILUS_SCRIPT" <<EOF
#!/usr/bin/env bash
# Installed by oma-quicky: opens the Quicky wheel on the selected files.
mapfile -t files < <(printf '%s' "\${NAUTILUS_SCRIPT_SELECTED_FILE_PATHS:-}" | sed '/^\$/d')
if ((\${#files[@]} == 0)); then
  exec "$self" open --wheel
fi
exec "$self" open "\${files[@]}"
EOF
  chmod +x "$NAUTILUS_SCRIPT"
  touch "$accels"
  grep -q " Quicky$" "$accels" || echo "$NAUTILUS_KEY Quicky" >>"$accels"
  echo "Nautilus: select files and press $NAUTILUS_KEY (restart Files with 'nautilus -q' first)."
}

# ---------------------------------------------------------------- main

main() {
  case ${1:-} in
    open) shift; open_wheel "$@"; return ;;
    setup) setup_nautilus; setup_hyprland; return ;;
    sounds)
      local flag="$HOME/.local/state/omarchy/toggles/quicky-muted"
      case ${2:-} in
        off) mkdir -p "$(dirname "$flag")" && touch "$flag" && echo "Quicky sounds off" ;;
        on) rm -f -- "$flag" && echo "Quicky sounds on" ;;
        *) [[ -e $flag ]] && echo off || echo on ;;
      esac
      return
      ;;
  esac

  (($# >= 3)) || { echo "usage: quicky convert|tool|action <name> FILE..." >&2; exit 2; }
  local mode=$1 name=$2; shift 2

  if [[ $mode == action ]]; then
    action "$name" "$@"
    return
  fi

  # Settings passed back by the quicky-compress window.
  local configured=0
  while [[ ${1:-} == --* ]]; do
    configured=1
    case $1 in
      --preset) PRESET=$2 ;;
      --scale) SCALE=$2 ;;
      --target-mb) TARGET_MB=$2 ;;
      --target-pct) TARGET_PCT=$2 ;;
      *) die "unknown option $1" ;;
    esac
    shift 2
  done

  # Editors are separate apps (see apps/); they report their own results.
  local -A editors=(
    [trim]=quicky-trim [strip]=quicky-metadata [crop]=quicky-crop [redact]=quicky-redact
    [compress]=quicky-compress [join]=quicky-join [merge]=quicky-join [make-pdf]=quicky-join
    [edit]=quicky-edit [annotate]=quicky-annotate [addbg]=quicky-addbg [collage]=quicky-collage
    [crop-video]=quicky-crop [speed]=quicky-speed [snapshot]=quicky-snapshot
    [split-video]=quicky-split [redact-video]=quicky-redact-video
    [normalize]=quicky-normalize [visualize]=quicky-visualize [channels]=quicky-channels
    [bleep]=quicky-bleep [organize]=quicky-organize
  )
  if [[ $mode == tool && -n ${editors[$name]:-} ]] && ((!configured)); then
    local app=${editors[$name]} args=()
    command -v "$app" >/dev/null || die "$app isn't installed (run apps/install.sh)"
    case $name in
      join) is_audio "$(ext_of "$1")" && args=(--mode audio) || args=(--mode video) ;;
      merge) args=(--mode pdf) ;;
      make-pdf) args=(--mode images) ;;
    esac
    # quicky-compress runs the encoders back through this script.
    QUICKY_BIN=$(realpath -- "$0") setsid -f "$app" "${args[@]}" "$@" >/dev/null 2>&1
    return
  fi

  local ok=0 failed=0
  for f in "$@"; do
    [[ -e $f ]] || { failed=$((failed + 1)); continue; }
    if [[ $mode == convert ]]; then convert_one "$f" "$(lower "$name")"; else tool_one "$name" "$f"; fi
    if (($? == 0)); then ok=$((ok + 1)); else failed=$((failed + 1)); fi
  done

  local label=$name; [[ $mode == convert ]] && label="→ $(tr '[:lower:]' '[:upper:]' <<<"$name")"
  if ((failed == 0)); then
    notify "Done $label" "$ok file(s) in $(dir_of "$1")"
  else
    notify "Finished with errors $label" "$ok done, $failed failed"
    exit 1
  fi
}

main "$@"
