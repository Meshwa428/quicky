[Desktop Entry]
Type=Application
Name=Quicky Bleep
GenericName=Bleep audio
Comment=Beep over parts of a recording, saved as a new copy
Exec=quicky-bleep %f
Icon=audio-x-generic
Terminal=false
NoDisplay=true
Categories=AudioVideo;Audio;AudioVideoEditing;
MimeType=audio/mpeg;audio/mp4;audio/x-wav;audio/wav;audio/flac;audio/ogg;audio/opus;audio/aac;audio/x-aiff;audio/x-ms-wma;
StartupWMClass=quicky.bleep
