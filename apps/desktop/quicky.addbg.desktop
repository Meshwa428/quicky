[Desktop Entry]
Type=Application
Name=Quicky Add Background
GenericName=Add a background
Comment=Place an image on a gradient, colour, or picture background
Exec=quicky-addbg %f
Icon=image-x-generic
Terminal=false
NoDisplay=true
Categories=Graphics;2DGraphics;RasterGraphics;
MimeType=image/jpeg;image/png;image/webp;image/heic;image/heif;image/tiff;image/avif;image/bmp;
StartupWMClass=quicky.addbg
