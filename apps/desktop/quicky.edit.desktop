[Desktop Entry]
Type=Application
Name=Quicky Edit Photo
GenericName=Adjust photos
Comment=Adjust a photo's light, color, and detail, saved as a new copy
Exec=quicky-edit %f
Icon=image-x-generic
Terminal=false
NoDisplay=true
Categories=Graphics;2DGraphics;RasterGraphics;
MimeType=image/jpeg;image/png;image/webp;image/heic;image/heif;image/tiff;image/avif;image/bmp;
StartupWMClass=quicky.edit
