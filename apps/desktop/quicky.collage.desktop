[Desktop Entry]
Type=Application
Name=Quicky Collage
GenericName=Make a collage
Comment=Lay several images out as one picture
Exec=quicky-collage %F
Icon=image-x-generic
Terminal=false
NoDisplay=true
Categories=Graphics;2DGraphics;RasterGraphics;
MimeType=image/jpeg;image/png;image/webp;image/heic;image/heif;image/tiff;image/avif;image/bmp;
StartupWMClass=quicky.collage
