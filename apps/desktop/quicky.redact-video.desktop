[Desktop Entry]
Type=Application
Name=Quicky Redact Video
GenericName=Redact video
Comment=Hide parts of a video for as long as needed, saved as a new copy
Exec=quicky-redact-video %f
Icon=video-x-generic
Terminal=false
NoDisplay=true
Categories=AudioVideo;Video;AudioVideoEditing;
MimeType=video/mp4;video/quicktime;video/x-matroska;video/webm;video/x-msvideo;video/x-ms-wmv;video/x-flv;
StartupWMClass=quicky.redact-video
