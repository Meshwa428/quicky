[Desktop Entry]
Type=Application
Name=Quicky Redact
GenericName=Redact images
Comment=Black out, pixelate, or blur parts of an image, saved as a new copy
Exec=quicky-redact %f
Icon=view-private
Terminal=false
Categories=Graphics;2DGraphics;RasterGraphics;
MimeType=image/jpeg;image/png;image/webp;image/heic;image/heif;image/tiff;image/avif;image/bmp;image/svg+xml;image/x-icon;
StartupWMClass=quicky.redact
