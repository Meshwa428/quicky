[Desktop Entry]
Type=Application
Name=Quicky Annotate
GenericName=Annotate images
Comment=Draw arrows, shapes, text, and callouts on an image, saved as a new copy
Exec=quicky-annotate %f
Icon=draw-freehand
Terminal=false
NoDisplay=true
Categories=Graphics;2DGraphics;RasterGraphics;
MimeType=image/jpeg;image/png;image/webp;image/heic;image/heif;image/tiff;image/avif;image/bmp;
StartupWMClass=quicky.annotate
